{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PMS：Desktop",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm tauri dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "PMS：Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @pms/web dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "PMS：Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm server:dev",
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "PMS：All",
      "configurations": [
        "PMS：Desktop",
        "PMS：Web",
        "PMS：Server"
      ],
      "stopAll": true
    }
  ]
}
